import Collatz.EffMeasure
import Collatz.LogTwoThreeBounds215

/-!
# The middle range `10³⁶ ≤ K < 10¹⁰⁰` of the effective measure (Gelfond L11)

For `10³⁶ ≤ K < 10¹⁰⁰` the bound `exp(−K/2⁸⁰) < |p log 2 − K log 3|` needs no transcendence input.
Consecutive convergents of `δ = log₂ 3` are Farey neighbours `a/b < δ < c/d`; for `K < b + d` every
`p/K` lies outside `(a/b, c/d)`, so `|p − Kδ| ≥ K · mg` with `mg` the distance from the 215-digit
enclosure to the nearer end, and `exp(−K/2⁸⁰) ≤ 2⁻¹⁰⁰⁰` is far below it. The @N@ segments are
generated by `computed/target14_norhin/l11/gen_l11.py`; the check is a rational computation.
-/

namespace Collatz

/-- One segment: Farey neighbours, outside the enclosure, and `0.6931471803 · L · mg · 2^1000 > 1`
where `mg` is the smaller distance from the enclosure to the two ends. -/
def midSegOK (L : ℕ) (s : FSeg) : Bool :=
  decide (0 < s.b ∧ 0 < s.d ∧ s.c * s.b - s.a * s.d = 1 ∧ (s.a : ℚ) / s.b < deltaLo215 ∧
    deltaHi215 < (s.c : ℚ) / s.d ∧ 1000 * 2 ^ 80 ≤ L ∧
    1 < 6931471803 / 10 ^ 10 * L *
      min (deltaLo215 - (s.a : ℚ) / s.b) ((s.c : ℚ) / s.d - deltaHi215) * 2 ^ 1000)

def midChain : ℕ → List FSeg → Bool
  | L, [] => decide (10 ^ 100 ≤ L)
  | L, s :: rest =>
    if s.b + s.d ≤ L then midChain L rest
    else midSegOK L s && midChain (s.b + s.d) rest

def midSegs : List FSeg := [
@LIST@]

theorem midChain_ok : midChain (10 ^ 36) midSegs = true := by decide +kernel

end Collatz
