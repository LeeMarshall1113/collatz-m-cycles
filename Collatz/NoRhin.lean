/-- The ceilings of Hercher's 91 entries from `EffMeasure`, one kernel check per `m`. -/
theorem hercherCeil_ok (m : ℕ) (h1 : 1 ≤ m) (h2 : m ≤ 91) :
    ceilOK m (hercherData.getD (m - 1) defaultEntry).Kf = true := by
  interval_cases m <;> decide +kernel

/-- **Hercher's theorem** (`m ≤ 91` excluded): if every `0 < n ≤ 695 · 2⁶⁰` reaches 1 and
`EffMeasure` holds, every nontrivial positive
`T`-cycle has at least 92 local minima. -/
theorem hercher_theorem_eff (hX₀ : ∀ n, 0 < n → n ≤ 695 * 2 ^ 60 → Reaches T n 1)
    (hE : EffMeasure) : HercherTheorem := by
  intro x p hx hp hcyc hx1 hx2
  by_contra hlt
  push_neg at hlt
  have hpos := numLocalMin_pos hx hp hcyc
  obtain ⟨m, hm⟩ : ∃ m, numLocalMin x p = m := ⟨_, rfl⟩
  have hK1 : 1 ≤ oddCount T x p := oddCount_pos_of_numLocalMin_pos hpos
  rw [hm] at hlt hpos
  have hlow : ∀ j, hercherX₀ ≤ T^[j] x := by
    intro j
    by_contra h
    push_neg at h
    unfold hercherX₀ at h
    exact cycle_not_reaches_one hp hcyc hx1 hx2 j (hX₀ _ (iterate_T_pos hx j) h.le)
  have he := hercherData_ok m (by omega) (by omega)
  unfold entryOK at he
  rw [Bool.and_eq_true] at he
  have h1 := chainOK_sound hx hp hcyc hm (by omega) hlow _ 1 _ hK1 he.1
  have h2 := K_lt_of_ceilOK hE hx hp hcyc hm (hercherCeil_ok m (by omega) (by omega))
  omega

/-- **No Collatz 92-cycle** whose elements all exceed `2⁷¹`, given `EffMeasure`. -/
theorem no_92_cycle_of_floor_eff (hE : EffMeasure) {x p : ℕ} (hx : 0 < x) (hp : 0 < p)
